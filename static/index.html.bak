<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Multi-Agent System</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
.container { background: white; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
width: 100%; max-width: 900px; height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
color: white; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; }
header h1 { font-size: 22px; margin-bottom: 2px; }
header p { opacity: 0.9; font-size: 13px; }
.header-btn { background: rgba(255,255,255,0.2); border: none; color: white;
padding: 8px 14px; border-radius: 20px; cursor: pointer; font-size: 16px; }
.header-btn.active { background: rgba(255,255,255,0.4); }
.agents-bar { display: flex; gap: 8px; padding: 14px 20px; background: #f7f7fa;
overflow-x: auto; border-bottom: 1px solid #e5e5ea; }
.agent-btn { padding: 8px 16px; border: 2px solid #e5e5ea; background: white;
border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: 500;
color: #555; white-space: nowrap; }
.agent-btn.active { background: #667eea; color: white; border-color: #667eea; }
.chat { flex: 1; overflow-y: auto; padding: 20px; display: flex;
flex-direction: column; gap: 14px; }
.message { padding: 12px 16px; border-radius: 16px; max-width: 80%;
line-height: 1.5; font-size: 15px; word-wrap: break-word; }
.message.user { background: #667eea; color: white; align-self: flex-end;
border-bottom-right-radius: 4px; }
.message.assistant { background: #f0f0f5; color: #333; align-self: flex-start;
border-bottom-left-radius: 4px; }
.message.assistant pre { background: #2d2d3a; color: #f0f0f5; padding: 10px;
border-radius: 8px; overflow-x: auto; margin: 6px 0; font-size: 13px; }
.message.assistant code { background: #e0e0e8; padding: 2px 6px;
border-radius: 4px; font-family: monospace; font-size: 13px; }
.sources { margin-top: 10px; padding-top: 10px; border-top: 1px solid #ddd; font-size: 12px; }
.sources a { display: block; color: #667eea; text-decoration: none;
margin: 3px 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.input-area { display: flex; gap: 10px; padding: 16px 20px; background: white;
border-top: 1px solid #e5e5ea; align-items: center; }
input[type="text"] { flex: 1; padding: 14px 18px; border: 2px solid #e5e5ea;
border-radius: 24px; font-size: 15px; outline: none; }
input[type="text"]:focus { border-color: #667eea; }
button.mic { width: 50px; height: 50px; border-radius: 50%; background: #f0f0f5;
border: 2px solid #e5e5ea; cursor: pointer; font-size: 22px;
display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
button.mic.listening { background: #ef4444; border-color: #ef4444;
animation: pulse 1s infinite; }
@keyframes pulse {
0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
50% { box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); } }
button.send { padding: 14px 24px; background: #667eea; color: white;
border: none; border-radius: 24px; font-size: 15px; font-weight: 600;
cursor: pointer; flex-shrink: 0; }
button.send:disabled { background: #ccc; cursor: not-allowed; }
.status { font-size: 12px; color: #888; padding: 4px 20px 0; min-height: 18px; }
.dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%;
background: #4ade80; margin-right: 6px; }
@media (max-width: 600px) {
.container { height: 100vh; border-radius: 0; }
body { padding: 0; }
header h1 { font-size: 18px; }
.message { max-width: 90%; font-size: 14px; } }
</style>
</head>
<body>
<div class="container">
<header>
<div>
<h1>Multi-Agent System</h1>
<p>Sesli kullanim: mikrofon butonuna bas</p>
</div>
<button class="header-btn active" id="ttsToggle" title="Sesli okuma">🔊</button>
</header>
<div class="agents-bar" id="agentsBar"></div>
<div class="status">
<span class="dot"></span>
<span id="statusText">Baglaniyor...</span>
</div>
<div class="chat" id="chat">
<div class="message assistant">
Multi-Agent System'e hos geldiniz!

Sesli kullanim:
1. Mikrofon butonuna bas
2. Sorunuzu soyleyin
3. Otomatik yaziya cevrilecek
4. Gonder'e bas
5. Cevabi dinleyin
</div>
</div>
<div class="input-area">
<button class="mic" id="micBtn" title="Konusmak icin bas">🎤</button>
<input type="text" id="messageInput" placeholder="Yazin veya mikrofonu kullanin..." autocomplete="off">
<button class="send" id="sendBtn">Gonder</button>
</div>
</div>
<script>
const API_BASE = window.location.origin;
let currentAgent = "researcher";
let isProcessing = false;
let ttsEnabled = true;
let recognition = null;
let isListening = false;

const chat = document.getElementById("chat");
const messageInput = document.getElementById("messageInput");
const sendBtn = document.getElementById("sendBtn");
const micBtn = document.getElementById("micBtn");
const agentsBar = document.getElementById("agentsBar");
const statusText = document.getElementById("statusText");
const ttsToggle = document.getElementById("ttsToggle");

function speak(text) {
if (!ttsEnabled || !("speechSynthesis" in window)) return;
window.speechSynthesis.cancel();
const clean = text.replace(/```[\s\S]*?```/g, " kod blogu ").replace(/[*_`#]/g, "");
const utter = new SpeechSynthesisUtterance(clean);
utter.lang = "tr-TR";
utter.rate = 1.0;
const voices = window.speechSynthesis.getVoices();
const trVoice = voices.find(v => v.lang.startsWith("tr"));
if (trVoice) utter.voice = trVoice;
window.speechSynthesis.speak(utter);
}

function stopSpeaking() { if ("speechSynthesis" in window) window.speechSynthesis.cancel(); }
ttsToggle.onclick = () => {
ttsEnabled = !ttsEnabled;
ttsToggle.classList.toggle("active", ttsEnabled);
if (!ttsEnabled) stopSpeaking();
};

const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SpeechRecognition) {
recognition = new SpeechRecognition();
recognition.lang = "tr-TR";
recognition.continuous = false;
recognition.interimResults = true;
recognition.onstart = () => {
isListening = true;
micBtn.classList.add("listening");
statusText.textContent = "Dinliyorum...";
stopSpeaking();
};
recognition.onresult = (event) => {
let finalText = "";
let interimText = "";
for (let i = event.resultIndex; i < event.results.length; i++) {
const transcript = event.results[i][0].transcript;
if (event.results[i].isFinal) finalText += transcript;
else interimText += transcript;
}
messageInput.value = finalText || interimText;
if (finalText) {
statusText.textContent = "Algilandi, gonderiliyor...";
setTimeout(() => { if (messageInput.value.trim()) sendMessage(); }, 400);
}
};
recognition.onerror = (event) => {
isListening = false;
micBtn.classList.remove("listening");
if (event.error === "not-allowed") statusText.textContent = "Mikrofon izni verilmedi";
else if (event.error === "no-speech") statusText.textContent = "Ses algilanamadi";
else statusText.textContent = "Hata: " + event.error;
setTimeout(() => { statusText.textContent = "Hazir"; }, 2000);
};
recognition.onend = () => {
isListening = false;
micBtn.classList.remove("listening");
if (statusText.textContent === "Dinliyorum...") statusText.textContent = "Hazir";
};
micBtn.onclick = () => {
if (isListening) recognition.stop();
else { stopSpeaking(); try { recognition.start(); } catch (e) { console.error(e); } }
};
} else {
micBtn.style.display = "none";
statusText.textContent = "Tarayici konusma tanimayi desteklemiyor";
}

async function loadAgents() {
try {
const res = await fetch(`${API_BASE}/api/agents`);
const data = await res.json();
agentsBar.innerHTML = "";
data.agents.forEach((agent) => {
const btn = document.createElement("button");
btn.className = "agent-btn" + (agent.name === currentAgent ? " active" : "");
btn.textContent = agent.name;
btn.onclick = () => {
currentAgent = agent.name;
document.querySelectorAll(".agent-btn").forEach((b) => b.classList.remove("active"));
btn.classList.add("active");
};
agentsBar.appendChild(btn);
});
statusText.textContent = `${data.count} agent hazir`;
} catch (e) { statusText.textContent = "Baglanti hatasi"; }
}

function escapeHtml(text) {
const div = document.createElement("div");
div.textContent = text;
return div.innerHTML;
}

function formatMarkdown(text) {
text = text.replace(/```(\w+)?\n([\s\S]*?)```/g, (m, lang, code) => `<pre>${escapeHtml(code.trim())}</pre>`);
text = text.replace(/`([^`]+)`/g, "<code>$1</code>");
text = text.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
return text;
}

function addMessage(text, role, sources) {
const div = document.createElement("div");
div.className = `message ${role}`;
if (role === "assistant") {
div.innerHTML = formatMarkdown(text);
if (sources && sources.length > 0) {
const sourcesDiv = document.createElement("div");
sourcesDiv.className = "sources";
sourcesDiv.innerHTML = "<strong>Kaynaklar:</strong>";
sources.forEach((s, i) => {
const a = document.createElement("a");
a.href = s.url;
a.target = "_blank";
a.textContent = `${i + 1}. ${s.title}`;
sourcesDiv.appendChild(a);
});
div.appendChild(sourcesDiv);
}
} else { div.textContent = text; }
chat.appendChild(div);
chat.scrollTop = chat.scrollHeight;
}

async function sendMessage() {
const message = messageInput.value.trim();
if (!message || isProcessing) return;
isProcessing = true;
sendBtn.disabled = true;
stopSpeaking();
messageInput.value = "";
addMessage(message, "user");
const loadingDiv = document.createElement("div");
loadingDiv.className = "message assistant";
loadingDiv.textContent = "Dusunuyor...";
chat.appendChild(loadingDiv);
chat.scrollTop = chat.scrollHeight;
try {
const res = await fetch(`${API_BASE}/api/ask`, {
method: "POST",
headers: { "Content-Type": "application/json" },
body: JSON.stringify({ message, agent: currentAgent, timeout: 60 })
});
loadingDiv.remove();
if (!res.ok) {
const err = await res.json();
const msg = `Hata: ${err.detail || "Bilinmeyen hata"}`;
addMessage(msg, "assistant");
speak(msg);
} else {
const data = await res.json();
addMessage(data.answer, "assistant", data.sources);
speak(data.answer);
}
} catch (e) {
loadingDiv.remove();
const msg = `Baglanti hatasi: ${e.message}`;
addMessage(msg, "assistant");
speak(msg);
} finally {
isProcessing = false;
sendBtn.disabled = false;
messageInput.focus();
}
}

sendBtn.onclick = sendMessage;
messageInput.addEventListener("keypress", (e) => { if (e.key === "Enter") sendMessage(); });
loadAgents();
messageInput.focus();
if ("speechSynthesis" in window) {
window.speechSynthesis.getVoices();
window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
}
</script>
</body>
</html>